#!/bin/bash
#SBATCH --job-name=MD_job
#SBATCH --account=<your-project-account>
#SBATCH --time=1:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-node=1
#SBATCH --mem=32G
#SBATCH --output=job_%j.log

# Example Slurm submission script, written for OSC's Cardinal cluster.
# Account/module/env names are placeholders -- swap in your own.
# The general shape (module load -> conda activate -> single Python
# entry point reading local JSON configs) should port to other
# Slurm-based clusters with minimal changes.

# 1. Clean environment
module purge
module load miniconda3/24.1.2-py310

# 2. Activate your conda environment
conda activate mace_env_gpu

# 3. Run every *.json config found in this directory
#    (see run_all.py -- dispatches by each config's "job" field)
python run_all.py > job.log
